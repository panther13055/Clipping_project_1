+    if (spec.shadowBlur) { c.shadowColor = "rgba(0,0,0,.7)"; c.shadowBlur = spec.shadowBlur; c.shadowOffsetY = spec.shadowY; }
+    c.strokeText(text, x, y);
+    c.fillStyle = fill;
+    c.fillText(text, x, y);
+    c.restore();
+  }
