@@ -483,3 +483,21 @@
 .compact-card { margin-top: 12px; }
 .mini-field input[type="range"] { width: 110px; }
 #panel-tools .row.compact-row input[type="text"] { flex: 1; min-width: 0; }
+.source-picker {
+  min-width: 250px;
+  margin-left: auto;
+}
+.source-picker select {
+  min-width: 250px;
+}
+@media (max-width: 900px) {
+  .source-picker { width: 100%; margin-left: 0; }
+  .source-picker select { width: 100%; min-width: 0; }
+}
+
+/* Multi-color Shorts title editor */
+.word-color-editor{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
+.word-color-chip{display:flex;align-items:center;gap:7px;padding:7px 9px;border:1px solid #2a3d59;border-radius:10px;background:rgba(7,15,28,.72);font-size:12px;font-weight:800;color:#dcecff;max-width:100%}
+.word-color-chip span{max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.word-color-chip input[type=color]{width:28px;height:24px;padding:0;border:0;background:transparent;cursor:pointer}
+.export-quality-note{margin-top:-2px;margin-bottom:10px;line-height:1.45}
